# ════════════════════════════════════════════════════════════
# .env.example — Конфигурация athena-memory (selti)
# ════════════════════════════════════════════════════════════

# ── PostgreSQL ──
DATABASE_URL=postgresql+asyncpg://athena:athena@localhost:5432/athene_memory
DB_MIN_CONNECTIONS=2
DB_MAX_CONNECTIONS=20

# ── Embedding (qwen3-embedding-8b) ──
EMBEDDING_API_URL=http://10.0.0.21:8080/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=qwen3-embedding-8b
EMBEDDING_DIMENSION=4096

# ── Qdrant (векторное хранилище) ──
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=memories
QDRANT_API_KEY=                    # для Qdrant Cloud (опционально)
QDRANT_ENABLED=true                # false = fallback на pgvector

# ── MCP Server ──
MCP_SERVER_NAME=athena-memory
MCP_HOST=0.0.0.0
MCP_PORT=8000
SEARCH_DEFAULT_LIMIT=10
SEARCH_DEFAULT_THRESHOLD=0.7

# ── Dedup ──
DEDUP_ENABLED=true
DEDUP_THRESHOLD=0.95

# ── API Key ──
API_KEY=

# ── Redis ──
REDIS_URL=redis://:@redis:6379/0

# ── Logging ──
LOG_LEVEL=INFO

# ════════════════════════════════════════════════════════════
# .env.example — Конфигурация athena-memory (selti)
# ════════════════════════════════════════════════════════════

# ── PostgreSQL ──
DATABASE_URL=postgresql+asyncpg://athena:athena@localhost:5432/athene_memory
DB_MIN_CONNECTIONS=2
DB_MAX_CONNECTIONS=10

# ── Embedding (qwen3-embedding-8b) ──
EMBEDDING_API_URL=http://10.0.0.21:8080/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=qwen3-embedding-8b
EMBEDDING_DIMENSION=4096

# ── Qdrant (векторное хранилище) ──
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=memories
QDRANT_API_KEY=                    # для Qdrant Cloud (опционально)
QDRANT_ENABLED=true                # false = только PostgreSQL без векторного поиска

# ── MCP Server ──
MCP_SERVER_NAME=athena-memory
MCP_HOST=0.0.0.0
MCP_PORT=8000
UVICORN_WORKERS=4
SEARCH_DEFAULT_LIMIT=10
SEARCH_DEFAULT_THRESHOLD=0.7

# ── Dedup ──
DEDUP_ENABLED=true
DEDUP_THRESHOLD=0.95

# ── API Key ──
API_KEY=

# ── Redis ──
REDIS_URL=redis://:@redis:6379/0

# ── Celery ──
CELERY_BROKER_URL=redis://localhost:6379/0          # Broker (Redis). В production — redis://:<password>@<host>:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0       # Хранилище результатов (Redis)
CELERY_TASK_SERIALIZER=json                          # Сериализация задач (json)
CELERY_RESULT_SERIALIZER=json                        # Сериализация результатов (json)
CELERY_ACCEPT_CONTENT=json                           # Допустимые форматы (json)
CELERY_TIMEZONE=UTC                                  # Часовой пояс

# ── Celery Worker ──
CELERY_WORKER_CONCURRENCY=4                          # Количество воркер-процессов (= CPU cores)
CELERY_WORKER_PREFETCH_MULTIPLIER=1                  # Prefetch = concurrency (fair scheduling)
CELERY_WORKER_MAX_TASKS_PER_CHILD=1000               # Реклайм памяти после 1000 задач
CELERY_WORKER_MAX_MEMORY_PER_CHILD=200000            # OOM-защита: 200 MB на процесс

# ── Celery Routes (очереди) ──
CELERY_TASK_ROUTES={"memory_server.tasks.memory_tasks.*":{"queue":"memory"},"memory_server.tasks.hash_tasks.*":{"queue":"hash"}}
CELERY_DEFAULT_QUEUE=memory                          # Очередь по умолчанию

# ── Celery Timeouts (секунды) ──
CELERY_TASK_SOFT_TIMEOUT_MEMORY=240                  # Soft timeout для memory-задач (embedding + PG)
CELERY_TASK_TIME_LIMIT_MEMORY=300                    # Hard timeout для memory-задач
CELERY_TASK_SOFT_TIMEOUT_BATCH=600                   # Soft timeout для batch-задач (большие объёмы)
CELERY_TASK_TIME_LIMIT_BATCH=900                     # Hard timeout для batch-задач
CELERY_TASK_SOFT_TIMEOUT_HASH=120                    # Soft timeout для hash-задач (простые CRUD)
CELERY_TASK_TIME_LIMIT_HASH=180                      # Hard timeout для hash-задач

# ── Logging ──
LOG_LEVEL=INFO
SERVICE_NAME=selti

# Base URL of the selti REST API. Empty = same origin (dev proxy forwards
# /api to SELTI_API_TARGET from vite.config.ts).
VITE_SELTI_API_BASE=

# Bearer token for production API access. Dev on localhost needs none.
VITE_SELTI_TOKEN=

# vite.config.ts reads this (not VITE_-prefixed — server-side only):
# SELTI_API_TARGET=http://localhost:8000

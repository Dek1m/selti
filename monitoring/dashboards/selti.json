{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "gauge",
      "name": "Gauge",
      "version": ""
    },
    {
      "type": "panel",
      "id": "bargauge",
      "name": "Bar gauge",
      "version": ""
    },
    {
      "type": "panel",
      "id": "row",
      "name": "Row",
      "version": ""
    },
    {
      "type": "panel",
      "id": "table",
      "name": "Table",
      "version": ""
    }
  ],
  "annotations": {
    "list": []
  },
  "description": "Selti (athena-memory) observability dashboard — RED metrics, Celery, DB Pool, Qdrant, Redis, Dedup, Business",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Overview",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "color": { "mode": "thresholds" }
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "title": "Health Status",
      "description": "Selti health check (1=ok, 0=error). Последнее состояние.",
      "type": "stat",
      "targets": [
        {
          "expr": "selti_health_status{check=\"db\"}",
          "legendFormat": "DB",
          "refId": "A"
        },
        {
          "expr": "selti_health_status{check=\"redis\"}",
          "legendFormat": "Redis",
          "refId": "B"
        },
        {
          "expr": "selti_health_status{check=\"qdrant\"}",
          "legendFormat": "Qdrant",
          "refId": "C"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" }
        }
      },
      "gridPos": { "h": 4, "w": 5, "x": 4, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "title": "HTTP Request Rate",
      "description": "RPS по методам. Суммарный rate всех HTTP запросов.",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(selti_http_requests_total{instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "Total RPS",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          },
          "color": { "mode": "thresholds" },
          "min": 0,
          "max": 1
        }
      },
      "gridPos": { "h": 4, "w": 5, "x": 9, "y": 1 },
      "id": 3,
      "options": {
        "minVizHeight": 75,
        "minVizWidth": 75,
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "title": "HTTP Error Rate",
      "description": "Доля HTTP ошибок (4xx+5xx). Зелёный < 1%, жёлтый < 5%, красный > 5%.",
      "type": "gauge",
      "targets": [
        {
          "expr": "sum(rate(selti_http_requests_total{status=~\"4..|5..\", instance=~\"$instance\"}[$__rate_interval])) / sum(rate(selti_http_requests_total{instance=~\"$instance\"}[$__rate_interval])) > 0",
          "legendFormat": "Error %",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red", "value": 2 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "gridPos": { "h": 4, "w": 5, "x": 14, "y": 1 },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "title": "HTTP Latency P95",
      "description": "P95 длительность HTTP запросов. Зелёный < 500ms, жёлтый < 2s, красный > 2s.",
      "type": "stat",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(selti_http_request_duration_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])) by (le))",
          "legendFormat": "P95",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" }
        }
      },
      "gridPos": { "h": 4, "w": 5, "x": 19, "y": 1 },
      "id": 5,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "title": "MCP Tool Rate",
      "description": "RPS MCP tool вызовов по статусам (ok / error / timeout).",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(selti_mcp_tool_calls_total{status=\"ok\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "OK",
          "refId": "A"
        },
        {
          "expr": "sum(rate(selti_mcp_tool_calls_total{status=\"error\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "Error",
          "refId": "B"
        },
        {
          "expr": "sum(rate(selti_mcp_tool_calls_total{status=\"timeout\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "Timeout",
          "refId": "C"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "HTTP RED",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "pointSize": 5,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          },
          "color": { "mode": "palette-classic" }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 6 },
      "id": 10,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "HTTP Rate (RPS by endpoint)",
      "description": "Количество HTTP запросов в секунду по эндпоинтам. Используй для выявления горячих маршрутов.",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (endpoint) (rate(selti_http_requests_total{instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{ method }} {{ endpoint }}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          },
          "color": { "mode": "palette-classic" }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 6 },
      "id": 11,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "HTTP Errors (by status)",
      "description": "Rate HTTP ошибок по статус-кодам. Если > 0 — смотри конкретные эндпоинты.",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (status) (rate(selti_http_requests_total{status=~\"4..|5..\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{ status }}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          },
          "color": { "mode": "palette-classic" }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 6 },
      "id": 12,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "HTTP Duration (P50/P95/P99)",
      "description": "Квантили длительности HTTP запросов. P95 — основной индикатор.",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(selti_http_request_duration_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])) by (le))",
          "legendFormat": "P50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(selti_http_request_duration_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])) by (le))",
          "legendFormat": "P95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(selti_http_request_duration_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])) by (le))",
          "legendFormat": "P99",
          "refId": "C"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 102,
      "title": "MCP Tools RED",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          },
          "color": { "mode": "palette-classic" }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 15 },
      "id": 20,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "MCP Tool Calls Rate (by tool)",
      "description": "RPS MCP tool вызовов по инструментам. Фильтруется переменной $tool.",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (tool) (rate(selti_mcp_tool_calls_total{tool=~\"$tool\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{ tool }}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          },
          "color": { "mode": "palette-classic" }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 15 },
      "id": 21,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "MCP Tool Errors (by tool & status)",
      "description": "Rate ошибок и таймаутов MCP tools. Если > 0 — расследуй.",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (tool, status) (rate(selti_mcp_tool_calls_total{status=~\"error|timeout\", tool=~\"$tool\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{ tool }} [{{ status }}]",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          },
          "color": { "mode": "palette-classic" }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 15 },
      "id": 22,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "MCP Tool Duration (P50/P95/P99)",
      "description": "Квантили длительности MCP tool вызовов по инструментам.",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(selti_mcp_tool_duration_seconds_bucket{tool=~\"$tool\", instance=~\"$instance\"}[$__rate_interval])) by (le, tool))",
          "legendFormat": "{{ tool }} P50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(selti_mcp_tool_duration_seconds_bucket{tool=~\"$tool\", instance=~\"$instance\"}[$__rate_interval])) by (le, tool))",
          "legendFormat": "{{ tool }} P95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(selti_mcp_tool_duration_seconds_bucket{tool=~\"$tool\", instance=~\"$instance\"}[$__rate_interval])) by (le, tool))",
          "legendFormat": "{{ tool }} P99",
          "refId": "C"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "id": 103,
      "title": "Celery Tasks",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          },
          "color": { "mode": "palette-classic" }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 24 },
      "id": 30,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "Celery Task Rate (by task & status)",
      "description": "Rate выполненных задач по имени и статусу (success / failure / retry).",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (task, status) (rate(selti_celery_tasks_total{instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{ task }} [{{ status }}]",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          },
          "color": { "mode": "palette-classic" }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 24 },
      "id": 31,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "Celery Task Duration (P50/P95)",
      "description": "Квантили длительности выполнения Celery задач. P95 > 30s = проблема.",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(selti_celery_task_duration_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])) by (le, task))",
          "legendFormat": "{{ task }} P50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(selti_celery_task_duration_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])) by (le, task))",
          "legendFormat": "{{ task }} P95",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          },
          "color": { "mode": "palette-classic" }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 24 },
      "id": 32,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "Celery Queue Latency (P50/P95)",
      "description": "Задержка задач в очереди (от send до start). P95 > 5s = очередь перегружена.",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(selti_celery_task_latency_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])) by (le, task))",
          "legendFormat": "{{ task }} P50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(selti_celery_task_latency_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])) by (le, task))",
          "legendFormat": "{{ task }} P95",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 20,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          },
          "color": { "mode": "palette-classic" }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 32 },
      "id": 33,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "Celery Queue Length",
      "description": "Длина очереди (pending задач). > 100 = предупреждение, > 500 = критично.",
      "type": "timeseries",
      "targets": [
        {
          "expr": "selti_celery_queue_length{instance=~\"$instance\"}",
          "legendFormat": "{{ queue }}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 32 },
      "id": 34,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "title": "Active Celery Workers",
      "description": "Количество активных воркеров. 0 = все воркеры упали (critical).",
      "type": "stat",
      "targets": [
        {
